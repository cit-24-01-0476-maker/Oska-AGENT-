# Vercel runtime configuration. Never commit actual values.
OSKA_MODE=cloud
APP_ORIGIN=https://your-project.vercel.app
GOOGLE_CLIENT_ID=your-web-client.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-web-client-secret
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace-with-at-least-32-random-characters
# Connect Postgres through your Vercel Storage integration; choose and review its plan yourself.
CLOUD_DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# Register APP_ORIGIN + /api/cloud/auth/callback in your Google OAuth Web client.
# Optional testing only, after adding APP_ORIGIN to Neon trusted domains:
# OSKA_AUTH_MODE=neon-preview
# NEON_AUTH_BASE_URL=https://your-endpoint.neonauth.region.aws.neon.tech/neondb/auth
# Preview uses shared Neon Google credentials and the existing AUTH_SECRET.
# It does not enable subscription model inference. Production needs your own OAuth client.
