DATABASE_URL="file:./oska.db"
# Optional absolute path to the official native agy executable. Never point at a shell script.
# AGY_EXECUTABLE="C:/path/to/agy.exe"
# Leave unset during normal use. Smoke test requires explicit opt-in.
# OSKA_CLI_SMOKE=1

# Optional OSKA website account login, separate from Antigravity AI authorization.
# Create a Google OAuth Web application client and register this exact callback:
# http://127.0.0.1:3000/api/auth/google/callback
# GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET="your-client-secret"
